# ==========================================
# SVG to Video Studio - Environment Template
# Rename this file to .env and fill in your actual credentials.
# Do NOT commit your actual .env file with secrets to GitHub.
# ==========================================

# 1. AI API Keys for SEO Kit (At least one is required)
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_grok_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Model Configurations
TEXT_MODEL_BASIC=grok-3-mini
TEXT_MODEL_ADVANCED=grok-3
IMAGE_MODEL=seedream-4.5
VIDEO_MODEL=seedance-1.5-pro

# 3. SMTP Email Configuration (For notifications/auth if needed)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_gmail_address_here
EMAIL_PASS=your_app_password_here
EMAIL_FROM="MetaGen AI <your_gmail_address_here>"

# 4. JSON Web Token (JWT) Security Config
JWT_SECRET=generate_a_random_long_secret_string_here
JWT_EXPIRES_IN=7d

# 5. MongoDB Database Configuration (Required)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/svg_to_video_db
MONGODB_DB_NAME=svg_to_video_db

# 6. Cloudinary Video CDN Hosting (Required for uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
